<!doctype html>
<html>
<head><meta charset="utf-8"><title>Add Employee</title></head>
<body>
  <h1>Add Employee</h1>
  <% if (error) { %><div style="color:red"><%= error %></div><% } %>
  <form method="post" action="/admin/employees/add">
    <label>Name: <input name="name" value="<%= old.name || '' %>" required></label><br>
    <label>Email: <input name="email" value="<%= old.email || '' %>" required></label><br>
    <label>Base Salary: <input name="baseSalary" type="number" value="<%= old.baseSalary || 0 %>" required></label><br>
    <label>HRA %: <input name="hraPercent" type="number" value="<%= old.hraPercent || 0 %>"></label><br>
    <label>DA %: <input name="daPercent" type="number" value="<%= old.daPercent || 0 %>"></label><br>
    <label>TAX %: <input name="taxPercent" type="number" value="<%= old.taxPercent || 0 %>"></label><br>
    <button type="submit">Add</button>
  </form>
  <p><a href="/admin/employees">Back</a></p>
</body>
</html>
